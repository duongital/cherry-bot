{
  "name": "bot-cherry",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:push": "pnpm --filter @bot-cherry/server db:push",
    "deploy": "pnpm deploy:server && pnpm deploy:client",
    "deploy:server": "pnpm --filter @bot-cherry/server deploy",
    "deploy:client": "node scripts/deploy-client.mjs",
    "dev:mobile": "pnpm --filter @bot-cherry/mobile start",
    "mobile:ios": "pnpm --filter @bot-cherry/mobile ios",
    "mobile:android": "pnpm --filter @bot-cherry/mobile android",
    "mobile:doctor": "pnpm --filter @bot-cherry/mobile exec expo-doctor"
  }
}
