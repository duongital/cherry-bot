# Copy to `.dev.vars` and fill in real values (`.dev.vars` is gitignored).
# Local-only secrets for `wrangler dev`. For production use `wrangler secret put`.

BETTER_AUTH_SECRET=replace-me-with-a-long-random-string
DATABASE_URL=postgresql://USER:PASSWORD@your-neon-pooler-host/neondb?sslmode=require
BETTER_AUTH_URL=http://localhost:8787
CLIENT_URL=http://localhost:5173
MOBILE_APP_SCHEME=botcherry

# Google OAuth (Cloudflare Console > Credentials > OAuth client ID, type Web).
# Production: wrangler secret put GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

DEEPSEEK_API_KEY=
# optional: override model (default: deepseek-v4-flash)
HEALTH_AGENT_MODEL=deepseek-v4-flash
